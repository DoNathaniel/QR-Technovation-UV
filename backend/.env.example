PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret

# Procesamiento persistente de correos. Se ejecuta dentro de este mismo backend.
EMAIL_QUEUE_INTERVAL_MS=10000
EMAIL_QUEUE_BATCH_SIZE=10

# Usa una clave aleatoria larga e independiente para firmar enlaces públicos.
NOTIFICATION_UNSUBSCRIBE_SECRET=replace_with_a_long_random_secret
NOTIFICATION_UNSUBSCRIBE_TOKEN_TTL=90d

# ZeptoMail
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=Technovation Girls Chile

# Google OAuth. Keep these values only in the backend environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
